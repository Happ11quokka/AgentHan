# 값을 채운 파일은 .env로 저장한다. .env는 커밋하지 않는다.
CLOVASTUDIO_API_KEY=
TAVILY_API_KEY=

# Object Storage를 쓸 때만 필요하다.
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
BUCKET_NAME=

# Part C 전화 주문 (voice). 비워 두면 전부 가짜(fake)로 키 없이 뜬다.
# 고르는 값: PHONE_NLU fake|hcx, PHONE_STT fake|clova, PHONE_TTS fake|clova
PHONE_NLU=
PHONE_STT=
PHONE_TTS=
# CLOVA Speech 스트리밍 STT (PHONE_STT=clova)
CLOVA_SPEECH_SECRET_KEY=
CLOVA_SPEECH_GRPC_ENDPOINT=
# CLOVA Voice Premium TTS (PHONE_TTS=clova)
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
# 선택(비우면 기본값). 무음 감지: 임계 RMS(1500), 말 시작 ms(200), 말 끝 무음 ms(400)
PHONE_VAD_THRESHOLD=
PHONE_VAD_START_MS=
PHONE_VAD_END_SILENCE_MS=
# 선택(비우면 기본값). 동시 통화 수(10), 통화 1건 최대 초(600)
PHONE_MAX_CALLS=
PHONE_MAX_CALL_S=
