# 값을 채운 파일은 .env로 저장한다. .env는 커밋하지 않는다.
CLOVASTUDIO_API_KEY=
TAVILY_API_KEY=

# Object Storage를 쓸 때만 필요하다.
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
BUCKET_NAME=

# NAVER API HUB 검색(지역·블로그). 검색 노출 진단(R3)에 쓴다.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# 비서 모드: planner(기본, 계획·실행 루프) | shadow(legacy로 답하고 플래너 계획은 trace에만) | legacy(키워드 라우팅). ADR-0005
# AGENT_MODE=planner
