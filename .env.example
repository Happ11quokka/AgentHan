# 값을 채운 파일은 .env로 저장한다. .env는 커밋하지 않는다.
CLOVASTUDIO_API_KEY=
TAVILY_API_KEY=

# Object Storage를 쓸 때만 필요하다.
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
BUCKET_NAME=

# 데이터베이스 (PostgreSQL + pgvector, docs/db.md). 비우면 DB 없이 JSON 파일로만 동작한다.
# 서버: AGENTHAN_DB_PASSWORD는 compose db 서비스 비밀번호, URL의 호스트는 db
# AGENTHAN_DB_URL=postgresql://agenthan:<비밀번호>@db:5432/agenthan
# AGENTHAN_DB_PASSWORD=
# 가게 지식 기본 가게 (비우면 dummy_store, 실제 데이터는 real)
# AGENTHAN_STORE_ID=

# NAVER API HUB 검색(지역·블로그). 검색 노출 진단(R3)에 쓴다.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# 비서 모드: planner(기본, 계획·실행 루프) | shadow(legacy로 답하고 플래너 계획은 trace에만) | legacy(키워드 라우팅). ADR-0005
# AGENT_MODE=planner

# Part C 전화 주문 (voice). 비워 두면 전부 가짜(fake)로 키 없이 뜬다.
# 고르는 값: PHONE_NLU fake|hcx, PHONE_STT fake|clova, PHONE_TTS fake|clova
PHONE_NLU=
PHONE_STT=
PHONE_TTS=
# CLOVA Speech 스트리밍 STT (PHONE_STT=clova)
CLOVA_SPEECH_SECRET_KEY=
CLOVA_SPEECH_GRPC_ENDPOINT=
# CLOVA Voice Premium TTS (PHONE_TTS=clova)
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
# 선택(비우면 기본값). 무음 감지: 임계 RMS(1500), 말 시작 ms(200), 말 끝(턴 판정) 무음 ms(400),
# epFlag를 먼저 보낼 무음 ms(250, 말 끝 무음 이하)
PHONE_VAD_THRESHOLD=
PHONE_VAD_START_MS=
PHONE_VAD_END_SILENCE_MS=
PHONE_VAD_EP_SILENCE_MS=
# 선택(비우면 기본값). 동시 통화 수(10), 통화 1건 최대 초(600)
PHONE_MAX_CALLS=
PHONE_MAX_CALL_S=
# 선택(비우면 기본값). 말이 이어질 모양("-하고", "그리고", "음")이면 마지막 말 끝부터 기다리는 초(2.0)
PHONE_CONT_WAIT_S=
# 선택(비우면 기본값). 봇 말이 끝나고 손님이 조용하면 되묻기까지의 초(6.0), "잠깐만요" 뒤 첫 대기 초(15.0)
PHONE_NO_INPUT_S=
PHONE_WAIT_REQUEST_S=
# 선택(비우면 기본값). 사장님 질문 카드를 보낸 뒤 답을 기다리는 초(20.0). 넘으면 "확인해서 문자로 알려 드릴게요"
PHONE_OWNER_WAIT_S=
# 선택(비우면 기본값). 오디오 턴 모델 Smart Turn(자체 호스팅 오픈 모델, 외부 API 호출 없음): smart_turn(기본)|off.
# 모델 파일 경로(기본 /app/models/smart-turn-v3.2-cpu.onnx). 로컬은 `uv run python -m agenthan.voice.fetch_turn_model`이
# 고정 리비전·SHA-256으로 받은 models/smart-turn-v3.2-cpu.onnx의 절대 경로. 없으면 끝말 규칙만으로 뜬다.
# 끝남 확률이 LOW(0.3) 이하면 이어짐, HIGH(0.7) 이상이면 끝남, 그 사이는 끝말 규칙
PHONE_TURN_MODEL=
PHONE_TURN_MODEL_PATH=
PHONE_TURN_LOW=
PHONE_TURN_HIGH=
# 선택(비우면 꺼짐). 음성 끼어들기: off(기본, 반이중 + 말 끊기 버튼)|shadow(봇 말 중 진짜 소리를 받아 판정만 기록)|on.
# 켜도 안드로이드 크롬만 봇 말 중 진짜 마이크 소리를 보낸다(아이폰·그 밖은 반이중). 실기기 시험 전에는 켜지 않는다.
# 문턱(비우면 기본값): 봇 말 중 소리로 볼 RMS(1500), 줄이기 ms(250), 멈춤 ms(1000, 1000 이상)
PHONE_VOICE_BARGE_IN=
PHONE_BARGE_THRESHOLD=
PHONE_BARGE_DUCK_MS=
PHONE_BARGE_STOP_MS=
# 6단계 운영 보강 (선택, 비우면 기본값. 로컬 개발은 비워 둔다). 뜻은 src/agenthan/voice/settings.py 머리 주석,
# 서버 권장값은 deploy/phone/README.md 4-1
# 문지기: 허용 오리진(비면 검사 안 함), 믿는 프록시 CIDR|private, 주소별 동시(4)·시간당(30) 통화,
# 하루 통화 수·분 상한(0 = 끔), WS 메시지 최대 바이트(65536)
PHONE_ALLOWED_ORIGINS=
PHONE_TRUSTED_PROXIES=
PHONE_IP_MAX_CALLS=
PHONE_IP_CALLS_PER_HOUR=
PHONE_DAY_MAX_CALLS=
PHONE_DAY_MAX_MINUTES=
PHONE_WS_MAX_BYTES=
# HCX 한도: NLU maxTokens(0 = 코드 기본), 요청 시간 제한 초(4), 실패 턴 폴백 rules|off, 분당 요청·토큰 상한(0 = 끔)
PHONE_NLU_MAX_TOKENS=
PHONE_NLU_TIMEOUT_S=
PHONE_NLU_FALLBACK=
PHONE_HCX_RPM=
PHONE_HCX_TPM=
# CLOVA Voice: 재시도(1), 실패 문장 무음 + 자막 caption|off, 요청 시간 제한 초(10)
PHONE_TTS_RETRIES=
PHONE_TTS_FALLBACK=
PHONE_TTS_TIMEOUT_S=
# 손님 말 JSONL·녹음 보관 일수(14. 로컬 logs/도 지운다, 0 = 안 지움), 디스크 경고 %(80)
PHONE_LOG_KEEP_DAYS=
PHONE_DISK_WARN_PCT=
# 주문 가드: 한 통화 총 수량·총액 상한 (비면 가게 JSON phone.max_order_qty·max_order_total, 기본 100 · 1,000,000)
PHONE_MAX_ORDER_QTY=
PHONE_MAX_ORDER_TOTAL=
# 사장님 허브 카드 상한: 끝난 통화 카드 수(50)·시간(24), 주문 카드 수(200)·시간(72)
PHONE_OWNER_MAX_CALL_CARDS=
PHONE_OWNER_CALL_CARD_HOURS=
PHONE_OWNER_MAX_ORDER_CARDS=
PHONE_OWNER_ORDER_CARD_HOURS=
