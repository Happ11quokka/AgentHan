# 값을 채운 파일은 .env로 저장한다. .env는 커밋하지 않는다.
CLOVASTUDIO_API_KEY=
TAVILY_API_KEY=

# Object Storage를 쓸 때만 필요하다.
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
BUCKET_NAME=

# Part C 전화 주문 (voice). 비워 두면 전부 가짜(fake)로 키 없이 뜬다.
# 고르는 값: PHONE_NLU fake|hcx, PHONE_STT fake|clova, PHONE_TTS fake|clova
PHONE_NLU=
PHONE_STT=
PHONE_TTS=
# CLOVA Speech 스트리밍 STT (PHONE_STT=clova)
CLOVA_SPEECH_SECRET_KEY=
CLOVA_SPEECH_GRPC_ENDPOINT=
# CLOVA Voice Premium TTS (PHONE_TTS=clova)
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
# 선택(비우면 기본값). 무음 감지: 임계 RMS(1500), 말 시작 ms(200), 말 끝(턴 판정) 무음 ms(400),
# epFlag를 먼저 보낼 무음 ms(250, 말 끝 무음 이하)
PHONE_VAD_THRESHOLD=
PHONE_VAD_START_MS=
PHONE_VAD_END_SILENCE_MS=
PHONE_VAD_EP_SILENCE_MS=
# 선택(비우면 기본값). 동시 통화 수(10), 통화 1건 최대 초(600)
PHONE_MAX_CALLS=
PHONE_MAX_CALL_S=
# 선택(비우면 기본값). 말이 이어질 모양("-하고", "그리고", "음")이면 마지막 말 끝부터 기다리는 초(2.0)
PHONE_CONT_WAIT_S=
# 선택(비우면 기본값). 오디오 턴 모델 Smart Turn(자체 호스팅 오픈 모델, 외부 API 호출 없음): smart_turn(기본)|off.
# 모델 파일 경로(기본 /app/models/smart-turn-v3.2-cpu.onnx, 로컬에서는 받은 파일 경로). 없으면 끝말 규칙만으로 뜬다.
# 끝남 확률이 LOW(0.3) 이하면 이어짐, HIGH(0.7) 이상이면 끝남, 그 사이는 끝말 규칙
PHONE_TURN_MODEL=
PHONE_TURN_MODEL_PATH=
PHONE_TURN_LOW=
PHONE_TURN_HIGH=
