# 값을 채운 파일은 .env로 저장한다. .env는 커밋하지 않는다.
CLOVASTUDIO_API_KEY=
TAVILY_API_KEY=

# Object Storage를 쓸 때만 필요하다.
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
BUCKET_NAME=

# NAVER API HUB 검색(지역·블로그). 검색 노출 진단(R3)에 쓴다.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# 비서 모드: legacy(기본) | shadow(플래너 계획을 trace에만 남김, ADR-0005). planner는 아직 없다(B5).
# AGENT_MODE=legacy
