# 서버의 deploy/phone/.env 틀 (티켓 09). 이름만 있다. 값은 서버에서만 채운다.
#   cp deploy/phone/.env.example deploy/phone/.env && chmod 600 deploy/phone/.env
# 키를 git·이미지·카톡 단체방에 올리지 않는다. 값에 $가 있으면 작은따옴표로 감싼다(compose가 $를 바꾼다)

# ---- Caddy (키 아님) ----
# DuckDNS 도메인. 예: agenthan.duckdns.org
DOMAIN=
# 비우면 Let's Encrypt 스테이징(시험용). 발급을 확인한 뒤 운영으로:
#   ACME_CA=https://acme-v02.api.letsencrypt.org/directory
ACME_CA=

# ---- 통화에 쓸 진짜 엔진 (비우면 전부 가짜). 실제 CLOVA 주문은 hcx / clova / clova ----
PHONE_NLU=
PHONE_STT=
PHONE_TTS=

# ---- 키 (서버에서만) ----
CLOVASTUDIO_API_KEY=
CLOVA_SPEECH_SECRET_KEY=
CLOVA_SPEECH_GRPC_ENDPOINT=
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=

# ---- 선택 (비우면 코드 기본값) ----
# 시연용 가게 시각 고정. 예: 2026-11-13T16:00:00+09:00
PHONE_NOW=
# 동시 통화(10), 통화 1건 최대 초(600)
PHONE_MAX_CALLS=
PHONE_MAX_CALL_S=
# Smart Turn(말 끝 판정 오디오 모델, 이미지에 들어 있음). 문제가 생기면 off로 끄고 app만 다시 띄운다
PHONE_TURN_MODEL=
# 음성 끼어들기 off(기본)|shadow|on. 안드로이드 크롬만. 실기기 시험(T1~T3) 통과 전에는 비워 둔다
PHONE_VOICE_BARGE_IN=
# 선택(비우면 기본값). 실기기 시험에서 바꾼 끼어들기 문턱: 봇 말 중 소리 RMS(1500), 멈춤 ms(1000 이상)
PHONE_BARGE_THRESHOLD=
PHONE_BARGE_STOP_MS=
# 이미지에 이미 들어 있음: PHONE_TZ=Asia/Seoul, GRPC_DNS_RESOLVER=native, PHONE_WEB_DIST, PHONE_LOG_DIR,
#   PHONE_TURN_MODEL_PATH=/app/models/smart-turn-v3.2-cpu.onnx
