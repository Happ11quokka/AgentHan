# 서버의 deploy/phone/.env 틀 (티켓 09). 이름만 있다. 값은 서버에서만 채운다.
#   cp deploy/phone/.env.example deploy/phone/.env && chmod 600 deploy/phone/.env
# 키를 git·이미지·카톡 단체방에 올리지 않는다. 값에 $가 있으면 작은따옴표로 감싼다(compose가 $를 바꾼다)

# ---- Caddy (키 아님) ----
# DuckDNS 도메인. 예: agenthan.duckdns.org
DOMAIN=
# 비우면 Let's Encrypt 스테이징(시험용). 발급을 확인한 뒤 운영으로:
#   ACME_CA=https://acme-v02.api.letsencrypt.org/directory
ACME_CA=

# ---- 통화에 쓸 진짜 엔진 (비우면 전부 가짜). 실제 CLOVA 주문은 hcx / clova / clova ----
PHONE_NLU=
PHONE_STT=
PHONE_TTS=

# ---- 키 (서버에서만) ----
CLOVASTUDIO_API_KEY=
CLOVA_SPEECH_SECRET_KEY=
CLOVA_SPEECH_GRPC_ENDPOINT=
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
# 사장님 화면 비밀 토큰(4단계). 사장님은 https://$DOMAIN/owner?key=<이 값> 으로 연다. 비우면 사장님 화면이 잠김(401)
#   만들기: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
PHONE_OWNER_KEY=
# Papago 번역(4단계 티켓 03). 사장님 카드의 손님 요청·손님 말을 러시아어로. 비우면 한국어 원문만
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=

# ---- 선택 (비우면 코드 기본값) ----
# 시연용 가게 시각 고정. 예: 2026-11-13T16:00:00+09:00
PHONE_NOW=
# 사장님 질문 답 대기 초(20.0). 리허설에서 맞춘다
PHONE_OWNER_WAIT_S=
# 동시 통화(10), 통화 1건 최대 초(600)
PHONE_MAX_CALLS=
PHONE_MAX_CALL_S=
# Smart Turn(말 끝 판정 오디오 모델, 이미지에 들어 있음). 문제가 생기면 off로 끄고 app만 다시 띄운다
PHONE_TURN_MODEL=
# ---- 늦은 조각 턴 쪼개짐 (6단계 티켓 02, "아니요, 그게 다예요") ----
# "더 필요하신 거 있으세요?" 뒤 맨 "아니요"를 말 끝부터 기다리는 초(1.2). 0이면 끔(바로 넘김)
PHONE_MORE_NO_WAIT_S=
# 반이중에서 마이크를 닫는 때. playback(기본): 봇 소리가 실제로 재생되기 시작할 때.
# state: 전처럼 서버가 speaking을 알릴 때. 봇 목소리가 손님 말로 잡히면 state로 돌린다
PHONE_MIC_CLOSE=
# 첫 소리 문지기 + 앞 턴 되감기 off(기본)|on. 봇 답의 첫 소리 전에 손님이 말을 이으면 그 답을 버리고
# 합친 말로 다시 처리한다. 아이폰 실기기에서 확인한 뒤에 켠다(voice README "6단계")
PHONE_TURN_REWIND=
# 되감기 문지기가 글 없는 소리(기침·배경 소리)를 기다리는 상한 초(3.0)
PHONE_GATE_MAX_S=
# 음성 끼어들기 off(기본)|shadow|on. 안드로이드 크롬만. 실기기 시험(T1~T3) 통과 전에는 비워 둔다
PHONE_VOICE_BARGE_IN=
# 선택(비우면 기본값). 실기기 시험에서 바꾼 끼어들기 문턱: 봇 말 중 소리 RMS(1500), 멈춤 ms(1000 이상)
PHONE_BARGE_THRESHOLD=
PHONE_BARGE_STOP_MS=
# Papago 요청 하나의 시간 제한 초(3). 넘으면 사장님 카드는 한국어 원문만
PHONE_TRANSLATE_TIMEOUT_S=
# Papago 유휴 연결을 닫지 않고 두는 초(60). 쉬었다 불러도 다시 연결하지 않게
PHONE_TRANSLATE_KEEPALIVE_S=

# ---- 6단계 운영 보강 (비우면 코드 기본값. 뜻·비상 대응은 README 4-1·4-2) ----
# 통화를 걸 수 있는 화면 오리진. 비우면 compose가 https://$DOMAIN을 넣는다. 다른 주소도 쓰면 쉼표로, 끄려면 *
PHONE_ALLOWED_ORIGINS=
# 믿는 프록시. 비우면 compose가 private(Caddy 컨테이너)를 넣는다
PHONE_TRUSTED_PROXIES=
# 주소 하나의 동시 통화(4)·시간당 통화(30). 0이면 끔. 발표장 와이파이는 여러 명이 주소 하나를 쓴다
PHONE_IP_MAX_CALLS=
PHONE_IP_CALLS_PER_HOUR=
# 하루 예산: 통화 수·통화 분 합계 (기본 0 = 끔). 공개 기간 권장 300 / 600. 넘으면 "오늘은 전화 주문이 마감됐어요"
PHONE_DAY_MAX_CALLS=
PHONE_DAY_MAX_MINUTES=
# HCX 한도: NLU maxTokens(0 = 코드 기본 512, 권장 200), 분당 요청(권장 70)·분당 토큰(권장 64000) 상한(0 = 끔),
# 실패한 턴을 규칙 NLU로 rules(기본)|off
PHONE_NLU_MAX_TOKENS=
PHONE_HCX_RPM=
PHONE_HCX_TPM=
PHONE_NLU_FALLBACK=
# CLOVA Voice 일시 오류: 재시도 횟수(1), 실패한 문장 하나를 무음 + 자막으로 caption(기본)|off, 요청 시간 제한 초(10)
PHONE_TTS_RETRIES=
PHONE_TTS_FALLBACK=
PHONE_TTS_TIMEOUT_S=
# 손님 말이 든 JSONL·녹음 보관 일수(14, 0 = 안 지움), 디스크 사용률 경고 %(80)
PHONE_LOG_KEEP_DAYS=
PHONE_DISK_WARN_PCT=
# 한 통화 총 수량·총액 상한. 비우면 가게 JSON(기본 100개 · 1,000,000원). 공개 기간 권장 30 / 300000
PHONE_MAX_ORDER_QTY=
PHONE_MAX_ORDER_TOTAL=
# 사장님 화면 카드 상한: 끝난 통화 카드 수(50)·시간(24), 주문 카드 수(200)·시간(72)
PHONE_OWNER_MAX_CALL_CARDS=
PHONE_OWNER_CALL_CARD_HOURS=
PHONE_OWNER_MAX_ORDER_CARDS=
PHONE_OWNER_ORDER_CARD_HOURS=

# 이미지에 이미 들어 있음: PHONE_TZ=Asia/Seoul, GRPC_DNS_RESOLVER=native, PHONE_WEB_DIST, PHONE_LOG_DIR,
#   PHONE_TURN_MODEL_PATH=/app/models/smart-turn-v3.2-cpu.onnx

# 통화 녹음 (디버그용, 5단계 티켓 01). 실기기 시험 때만 켠다. 발표·심사 때는 이 줄을 지운다
# (심사위원 목소리를 남기지 않는다). 녹음은 로그 볼륨에 남는다: /app/logs/recordings/YYYYMMDD/<통화 id>.wav
# PHONE_RECORD_DIR=/app/logs/recordings

# 데이터베이스 (compose db 서비스, docs/db.md). 비밀번호를 정하고 URL에도 같은 값을 넣는다.
# 비워 두면 db 컨테이너는 뜨지 않고 앱은 JSON 파일로만 동작한다.
AGENTHAN_DB_PASSWORD=
AGENTHAN_DB_URL=
