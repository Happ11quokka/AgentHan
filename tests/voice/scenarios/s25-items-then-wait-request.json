{
  "id": "s25-items-then-wait-request",
  "title": "3단계: 항목 + 잠시만요 → 항목은 담고 질문 대신 천천히 말씀하세요. 다음 무응답은 직전 질문",
  "now": "2026-11-08T17:10:00+09:00",
  "turns": [
    {
      "guest": "메도빅 하나랑 잠시만요",
      "wait_request": true,
      "expect_state": "ordering",
      "expect_cart": [{"menu_id": "m01", "qty": 1}],
      "expect_say": ["메도빅 하나요.", "천천히 말씀하세요."]
    },
    {
      "event": "no_input",
      "expect_say": ["여보세요?", "더 필요하신 거 있으세요?"]
    },
    {
      "guest": "그게 다예요",
      "expect_state": "ask_pickup",
      "expect_say": ["몇 시쯤 오세요?"]
    },
    {
      "guest": "음 잠깐만요",
      "wait_request": true,
      "expect_state": "ask_pickup",
      "expect_say": ["네, 천천히 말씀하세요."]
    },
    {
      "event": "no_input",
      "expect_say": ["여보세요?", "몇 시쯤 오세요?"]
    },
    {
      "guest": "여섯시 반이요",
      "expect_state": "confirm"
    },
    {
      "guest": "네",
      "expect_state": "closing"
    }
  ],
  "expect_order": {
    "lines": [{"menu_id": "m01", "quantity": 1}],
    "pickup_time": "2026-11-08T18:30:00+09:00",
    "status": "confirmed"
  }
}
