{
  "id": "s41-customer-cancel-after-delay",
  "title": "대기 없는 주문: 사장님 [+15분]으로 확정 → 손님이 바뀐 시각이 싫어 주문 현황에서 취소",
  "now": "2026-11-08T17:10:00+09:00",
  "approval": true,
  "turns": [
    {
      "guest": "메도빅 하나요",
      "expect_state": "ordering",
      "expect_cart": [
        {
          "menu_id": "m01",
          "qty": 1
        }
      ]
    },
    {
      "guest": "그게 다예요",
      "expect_state": "ask_pickup"
    },
    {
      "guest": "6시 반이요",
      "expect_state": "confirm"
    },
    {
      "guest": "네",
      "expect_state": "closing",
      "expect_request": 1,
      "expect_say_exact": [
        "주문 넣어 드렸어요. 가게에서 확인하면 화면으로 알려 드릴게요. 감사합니다."
      ]
    }
  ],
  "after_call": [
    {
      "owner": "accept",
      "delay_min": 15
    },
    {
      "customer": "cancel"
    }
  ],
  "after_call_s": 120,
  "expect_order": {
    "lines": [
      {
        "menu_id": "m01",
        "quantity": 1
      }
    ],
    "pickup_time": "2026-11-08T18:30:00+09:00",
    "status": "confirmed"
  },
  "expect_owner": {
    "status": "customer_cancelled",
    "owner_pickup_time": "2026-11-08T18:45:00+09:00",
    "sms": [
      "delayed"
    ]
  },
  "expect_status": {
    "stage": "cancelled",
    "outcome": "customer_cancelled",
    "can_cancel": false
  }
}
